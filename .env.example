# ---- Application -------------------------------------------------------------
APP_ENV=development                # development | test | production
APP_SECRET_KEY=change-me           # >=32 random chars; REQUIRED in production
SESSION_SECRET=change-me           # >=32 random chars; REQUIRED in production
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# ---- Datastores --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civiclens
REDIS_URL=redis://localhost:6379/0

# ---- Groq Cloud (optional) - hosted chat + Whisper speech-to-text ------------------------------
# When GROQ_API_KEY is set, chat/generation uses Groq instead of local Ollama (embeddings and OCR
# vision stay on Ollama). Get a free key at https://console.groq.com - NEVER commit the real key.
GROQ_API_KEY=
GROQ_MODEL=                        # e.g. openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Ollama / RAG ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_VISION_MODEL=
EMBEDDING_DIMENSIONS=              # must equal the embedding model's output size
RAG_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RERANK_TOP_K=20
RAG_MIN_RELEVANCE=0.15             # evidence below this reranker score is discarded

# ---- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Optional: Bhashini ------------------------------------------------------
BHASHINI_ENABLED=false
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ---- Optional: Google Drive --------------------------------------------------
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CREDENTIALS_FILE=           # path to a service-account JSON kept OUTSIDE the repo

# ---- Government adapters (all optional; unset => NOT_CONFIGURED) -------------
# Endpoints and paths are deliberately NOT defaulted: no public, documented API
# contract was supplied, so none is invented.
# For EACH platform <P> in CPGRAMS, UMANG, SWACHHATA, BBMP_SAHAAYA, MYGOV an adapter is
# CONFIGURED only when all of these are set: <P>_BASE_URL, <P>_API_KEY and the three
# required endpoint paths (HEALTH, SUBMIT, STATUS). Optional: UPDATE, REFERENCE, SYNC.
CPGRAMS_BASE_URL=
CPGRAMS_API_KEY=
CPGRAMS_ENDPOINT_HEALTH=
CPGRAMS_ENDPOINT_SUBMIT=
CPGRAMS_ENDPOINT_STATUS=
CPGRAMS_ENDPOINT_UPDATE=
CPGRAMS_ENDPOINT_REFERENCE=
CPGRAMS_ENDPOINT_SYNC=
# ...repeat the same block for UMANG_*, SWACHHATA_*, BBMP_SAHAAYA_*, MYGOV_*
GOV_ADAPTER_TIMEOUT_SECONDS=10
GOV_ADAPTER_MAX_RETRIES=2

# ---- RTI statutory rules (defaults reflect the RTI Act, 2005) ----------------
RTI_RESPONSE_DAYS=30
RTI_LIFE_LIBERTY_HOURS=48
RTI_PDF_FONT=                      # path to a Unicode .ttf, required to export non-Latin RTI text as PDF

# ---- Admin bootstrap / e-mail / public URL ----------------------------------
ADMIN_SETUP_TOKEN=                 # one-time token for creating the FIRST super-admin (unset = bootstrap disabled)
PUBLIC_BASE_URL=http://localhost:8080   # used in password-reset links
SMTP_HOST=                         # unset = e-mail delivery reports "not_sent" (never "delivered")
SMTP_PORT=587
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_DRIVE_FOLDER_ID=
BHASHINI_PIPELINE_ID=
SENTRY_DSN=                         # unset = error tracking "not_configured" (checked at /monitoring/system); PII is never sent when set
SENTRY_TRACES_SAMPLE_RATE=0         # 0-1; performance tracing is off by default

# ---- Speech-to-text (voice input keeps the SPOKEN language and script; nothing is translated) -------------------
STT_PROVIDER=auto                  # auto | bhashini | whisper | groq_whisper | none   (auto = Bhashini if configured, else none)
WHISPER_MODEL=                     # e.g. small / medium / large-v3 (STT_PROVIDER=whisper; needs faster-whisper; bigger = better for Kannada/Tamil/Telugu)
BHASHINI_ASR_LANGUAGES=            # comma list to narrow what Bhashini is offered for (default en,hi,mr,bn,gu,pa,ta,te,kn,ml)
# ---- OCR for scanned PDFs / photographed documents -------------------------------------------------------------
OCR_PROVIDER=none                  # none | tesseract | ollama_vision
OCR_LANGUAGES=eng                  # Tesseract packs to use, e.g. eng+hin+kan+tam+tel (each needs its traineddata installed)
TESSERACT_CMD=                     # full path to tesseract.exe; unset = resolved from PATH (needed on installs without admin rights to modify system PATH)
TESSDATA_DIR=                      # directory holding <lang>.traineddata; unset = tesseract's own default location. Must not contain a space (Windows arg-passing limitation).
# ---- Mobile push (Expo) ----------------------------------------------------------------------------------------
EXPO_PUSH_ENABLED=false            # true = the server may call https://exp.host/--/api/v2/push/send
